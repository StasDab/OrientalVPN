BOT_TOKEN=your_bot_token_from_botfather
PROVIDER_TOKEN=
PAYMENTS_PROVIDER_NAME=
ADMIN_IDS=123456789

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myvpn
REDIS_URL=redis://localhost:6379/0

POSTGRES_DB=myvpn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

VPN_PROVIDER=marzban
PANEL_URL=https://panel.example.com
PANEL_USERNAME=marzban_api_login
PANEL_PASSWORD=change_me

TRIAL_HOURS=3
CHECK_INTERVAL_MINUTES=10
PROVISION_RETRIES=3
EVENT_MAX_RETRIES=30
REMINDER_HOURS_BEFORE=24

# Обязательно для бота: без этого пробный доступ и выбор локации не работают.
# location_code должен совпадать с inbound в Marzban: loc-<код>, например loc-se.
# api_url обычно совпадает с PANEL_URL для одной панели.
VPN_NODES_JSON=[{"location_code":"se","api_url":"https://panel.example.com","capacity":1000,"current_load":0,"is_healthy":true}]
