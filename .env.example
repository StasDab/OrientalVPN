BOT_TOKEN=your_bot_token_from_botfather
PROVIDER_TOKEN=
PAYMENTS_PROVIDER_NAME=
ADMIN_IDS=123456789

# Пароль здесь должен совпадать с POSTGRES_PASSWORD в контейнере (infra/docker-compose.yml: postgres).
# Ошибка «password authentication failed» → на VPS:
#   /opt/myvpn/.venv/bin/python scripts/fix_postgres_password.py
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/myvpn
REDIS_URL=redis://localhost:6379/0

POSTGRES_DB=myvpn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

VPN_PROVIDER=marzban
PANEL_URL=https://panel.example.com
PANEL_USERNAME=marzban_api_login
PANEL_PASSWORD=change_me

# Необязательно: другой хост в ссылке подписки (nginx на поддомене → тот же Marzban /sub/...).
# SUBSCRIPTION_URL_PREFIX=https://sub.example.com

# --- XRAY_SUBSCRIPTION_URL_PREFIX: НЕ в этом файле бота. ---
# Задаётся в .env (или env) установки Marzban — там, где лежит docker-compose панели
# (часто /opt/marzban/.env, ~/marzban/.env или рядом с compose). Пример значения:
#   XRAY_SUBSCRIPTION_URL_PREFIX=https://panel.example.com
# Без /dashboard/. После правки: перезапуск контейнера/сервиса Marzban.

TRIAL_HOURS=3
CHECK_INTERVAL_MINUTES=10
PROVISION_RETRIES=3
EVENT_MAX_RETRIES=30
REMINDER_HOURS_BEFORE=24

# VLESS Vision для REALITY: по умолчанию в коде уже xtls-rprx-vision. Чтобы отключить — MARZBAN_VLESS_FLOW=
MARZBAN_VLESS_FLOW=xtls-rprx-vision

# uTLS для payload API бота. Чтобы в ссылке подписки /sub/... был fp=qq, в Marzban задайте
# Host для inbound → Fingerprint = qq (панель иначе подставляет chrome в share-link).
MARZBAN_REALITY_FINGERPRINT=qq

# Страховка от “истекло сразу”: добавляем несколько секунд к expire при создании пользователя в Marzban.
MARZBAN_EXPIRE_SKEW_SECONDS=300

# Обязательно для бота: без этого пробный доступ и выбор локации не работают.
# По умолчанию тег inbound = loc-<location_code> (должен совпасть с тегом в Core).
# Иначе укажите inbound_tag и при необходимости vless в JSON ноды.
# api_url обычно совпадает с PANEL_URL для одной панели.
# Две локации через одну Marzban-панель + node: разный inbound_tag (см. Core JSON).
# link_match — уникальная подстрока из vless-ссылки узла (часть IP/хоста), чтобы бот мог выдать «одну ссылку на сервер».
VPN_NODES_JSON=[
  {"location_code":"se","inbound_tag":"loc-se","link_match":"138.124.","api_url":"https://panel.example.com:8443","capacity":1000,"current_load":0,"is_healthy":true},
  {"location_code":"us","inbound_tag":"loc-us","link_match":"77.110.","api_url":"https://panel.example.com:8443","capacity":1000,"current_load":0,"is_healthy":true}
]
