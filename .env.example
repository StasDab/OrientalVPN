BOT_TOKEN=your_bot_token_from_botfather
PROVIDER_TOKEN=
PAYMENTS_PROVIDER_NAME=
ADMIN_IDS=123456789

# Юзернейм бота без @ — для реферальных ссылок https://t.me/{username}?start=ref_<tg_id>
PUBLIC_BOT_USERNAME=OrientalVPNbot

# Бонус пригласившему с платежа реферала (после скидок): сумма × BPS ÷ 10000. 1000 = 10%.
REFERRAL_COMMISSION_BPS=1000
START_BANNER_URL=
START_BANNER_PATH=

# --- Оплата ---
# Режим A (обычный): ЮKassa/другая касса подключены к боту в BotFather → PROVIDER_TOKEN.
# Тогда PAYMENT_PROVIDER=telegram, поля YOOKASSA_* можно не заполнять — счёт показывает Telegram (send_invoice).
#
# Режим B (обход Telegram Payments): PAYMENT_PROVIDER=yookassa + YOOKASSA_SHOP_ID + SECRET_KEY + HTTPS RETURN_URL.
# Если PROVIDER_TOKEN пуст, но ключи ЮKassa заданы и здесь telegram — включается режим B как запасной.
PAYMENT_PROVIDER=telegram
# Минимальная сумма пополнения в ₽ через send_invoice (у провайдера Telegram маленький чек = CURRENCY_TOTAL_AMOUNT_INVALID).
TELEGRAM_MIN_INVOICE_RUB=100
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/YourBot

# Пароль здесь должен совпадать с POSTGRES_PASSWORD в контейнере (infra/docker-compose.yml: postgres).
# Ошибка «password authentication failed» → на VPS:
#   /opt/myvpn/.venv/bin/python scripts/fix_postgres_password.py
# Ошибка «database \"myvpn\" does not exist» → создать БД:
#   /opt/myvpn/.venv/bin/python scripts/ensure_postgres_database.py
#   (или: docker exec myvpn-postgres psql -U postgres -d postgres -c "CREATE DATABASE myvpn;")
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/myvpn
# Обязательно для сессии FSM (/пополнение, промокод): без Redis состояние теряется при перезапуске бота.
REDIS_URL=redis://localhost:6379/0

POSTGRES_DB=myvpn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

VPN_PROVIDER=marzban
PANEL_URL=https://panel.example.com
PANEL_USERNAME=marzban_api_login
PANEL_PASSWORD=change_me

# Необязательно: другой хост в ссылке подписки (nginx на поддомене → тот же Marzban /sub/...).
# SUBSCRIPTION_URL_PREFIX=https://sub.example.com

# --- XRAY_SUBSCRIPTION_URL_PREFIX: НЕ в этом файле бота. ---
# Задаётся в .env (или env) установки Marzban — там, где лежит docker-compose панели
# (часто /opt/marzban/.env, ~/marzban/.env или рядом с compose). Пример значения:
#   XRAY_SUBSCRIPTION_URL_PREFIX=https://panel.example.com
# Без /dashboard/. После правки: перезапуск контейнера/сервиса Marzban.

TRIAL_HOURS=3
CHECK_INTERVAL_MINUTES=10
PROVISION_RETRIES=3
EVENT_MAX_RETRIES=30
REMINDER_HOURS_BEFORE=24

# VLESS Vision для REALITY: по умолчанию в коде уже xtls-rprx-vision. Чтобы отключить — MARZBAN_VLESS_FLOW=
MARZBAN_VLESS_FLOW=xtls-rprx-vision

# uTLS для payload API бота. Чтобы в ссылке подписки /sub/... был fp=qq, в Marzban задайте
# Host для inbound → Fingerprint = qq (панель иначе подставляет chrome в share-link).
MARZBAN_REALITY_FINGERPRINT=qq

# Страховка от “истекло сразу”: добавляем несколько секунд к expire при создании пользователя в Marzban.
MARZBAN_EXPIRE_SKEW_SECONDS=300

# Лимит «одновременных IP» в proxies.vless (поле limitIp). Дублирует шлюз — по умолчанию 0.
MARZBAN_VLESS_LIMIT_IP=0

# Шлюз подписки (лимит устройств по IP+User-Agent). Публичный URL — за nginx → этот порт (8095).
# Если на VPS Xray слушает 443, HTTPS для sub ставьте на другой порт (например 9443), см. infra/nginx-subscription-gate.conf.example
# SUBSCRIPTION_GATE_PUBLIC_BASE=https://sub.example.com:9443
# SUBSCRIPTION_MAX_DEVICES=2
# SUBSCRIPTION_GATE_LISTEN_HOST=0.0.0.0
# SUBSCRIPTION_GATE_LISTEN_PORT=8095

# Обязательно для бота: без этого пробный доступ и выбор локации не работают.
# По умолчанию тег inbound = loc-<location_code> (должен совпасть с тегом в Core).
# Иначе укажите inbound_tag и при необходимости vless в JSON ноды.
# api_url обычно совпадает с PANEL_URL для одной панели.
# Две локации через одну Marzban-панель + node: разный inbound_tag (см. Core JSON).
# link_match или link_matches — подстроки из поля links у GET /api/user/<tg_*>, чтобы выдать одну vless на узел.
# Пример под OrientalVPN (проверьте IP/домен в реальных ссылках; при необходимости добавьте варианты в link_matches).
VPN_NODES_JSON=[
  {"location_code":"se","inbound_tag":"loc-se","link_matches":["138.124."],"api_url":"https://panel.orientalvpn.ru:8443","capacity":1000,"current_load":0,"is_healthy":true},
  {"location_code":"us","inbound_tag":"loc-us","link_matches":["77.110."],"api_url":"https://panel.orientalvpn.ru:8443","capacity":1000,"current_load":0,"is_healthy":true}
]
