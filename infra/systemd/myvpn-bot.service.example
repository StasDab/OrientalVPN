# systemd unit: Telegram-бот + Alembic перед стартом.
# Сервис от системного пользователя myvpn (без root).
# Postgres/Redis — например Docker на localhost:5432 / 6379.
#
# Один раз на сервере:
#   sudo useradd --system --user-group --create-home \
#     --home-dir /var/lib/myvpn --shell /usr/sbin/nologin myvpn
#   sudo git clone <repo> /opt/myvpn
#   cd /opt/myvpn && sudo chown -R myvpn:myvpn /opt/myvpn
#   sudo -u myvpn python3.12 -m venv /opt/myvpn/.venv
#   sudo -u myvpn /opt/myvpn/.venv/bin/pip install -r /opt/myvpn/requirements.txt
#   # секреты только root: sudo install -m 600 -o myvpn -g myvpn /dev/null /opt/myvpn/app/.env
#   # затем sudo nano /opt/myvpn/app/.env или копирование с правами 600 и владельцем myvpn
#   # скрипты с docker exec (fix_postgres_password.py) — только от root
#   sudo cp infra/systemd/myvpn-bot.service.example /etc/systemd/system/myvpn-bot.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now myvpn-bot
#
# WorkingDirectory — корень репозитория (рядом с alembic.ini).
# Если Postgres не в Docker — уберите docker.service из After= / Wants=.

[Unit]
Description=MyVpn Telegram bot (aiogram)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=myvpn
Group=myvpn
WorkingDirectory=/opt/myvpn
EnvironmentFile=/opt/myvpn/app/.env
ExecStartPre=/opt/myvpn/.venv/bin/python -m alembic upgrade head
ExecStart=/opt/myvpn/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
