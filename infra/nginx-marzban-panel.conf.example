# Скопируйте на сервер, например:
#   sudo cp infra/nginx-marzban-panel.conf.example /etc/nginx/sites-available/panel.orientalvpn.ru
# Замените panel.orientalvpn.ru на свой поддомен при необходимости.
#
# Этап 1 — только HTTP (порт 80), для проверки и выпуска сертификата certbot:
#   sudo ln -sf /etc/nginx/sites-available/panel.orientalvpn.ru /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d panel.orientalvpn.ru
#
# После certbot в этот файл добавятся ssl_certificate и listen 443 ssl — либо
# certbot правит файл сам. Проверьте, что блок server для 443 проксирует на 127.0.0.1:8000.

# --- HTTP: редирект на HTTPS (раскомментируйте после успешного certbot, если certbot не сделал сам) ---
# server {
#     listen 80;
#     listen [::]:80;
#     server_name panel.orientalvpn.ru;
#     return 301 https://$host$request_uri;
# }

# --- Первый запуск: только listen 80 и location ниже; certbot добавит SSL ---
server {
    listen 80;
    listen [::]:80;
    server_name panel.orientalvpn.ru;

    # Для выпуска сертификата Let's Encrypt (certbot webroot/nginx)
    location ^/.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location ~* ^/(dashboard|statics|sub|api|docs|redoc|openapi\.json)(/.*)?$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }

    location = / {
        return 302 /dashboard/;
    }
}

# После certbot --nginx появится второй server { listen 443 ssl; ... } с теми же location —
# если certbot создал только SSL без proxy, скопируйте блоки location из server :80 в server :443.
